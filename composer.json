{
    "name": "inboxcom/mailcore-php",
    "description": "PHP client for the Mailcore mail-server API (third-party, unofficial).",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Sebastian Karlsen", "email": "sebastian@corp.inbox.com" }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.10",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "zircote/swagger-php": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Inboxcom\\Mailcore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inboxcom\\Mailcore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "gen:openapi": "php bin/generate-openapi.php",
        "openapi:check": "php bin/generate-openapi.php --check",
        "contract:cleanup": "php bin/contract-cleanup.php",
        "docs:build": [
            "@gen:openapi",
            "npx --yes @redocly/cli build-docs build/openapi.yaml -o build/docs.html"
        ],
        "docs:preview": [
            "@docs:build",
            "Composer\\Config::disableProcessTimeout",
            "DOCS_INDEX=docs.html php -S localhost:8080 -t build bin/docs-router.php"
        ],
        "docs:swagger": [
            "@gen:openapi",
            "@php -r \"copy('resources/swagger-ui.html', 'build/swagger.html');\"",
            "Composer\\Config::disableProcessTimeout",
            "DOCS_INDEX=swagger.html php -S localhost:8081 -t build bin/docs-router.php"
        ]
    },
    "scripts-descriptions": {
        "docs:build": "Regenerate the spec and write a self-contained build/docs.html (Redoc). Needs Node/npx.",
        "docs:preview": "Build the docs, then serve Redoc at http://localhost:8080/. Needs Node/npx.",
        "docs:swagger": "Regenerate the spec and serve Swagger UI at http://localhost:8081/. Needs only PHP (UI assets load from a CDN)."
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev",
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
